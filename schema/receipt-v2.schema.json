{
  "$defs": {
    "CheckEvidence": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cancelled": {
          "type": "boolean"
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "incomplete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "timed_out": {
          "type": "boolean"
        },
        "working_directory": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "required",
        "argv",
        "working_directory",
        "status",
        "duration_ms",
        "timed_out",
        "cancelled"
      ],
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING",
        "NOT_RUN"
      ],
      "type": "string"
    },
    "MatrixReceiptV2": {
      "additionalProperties": false,
      "properties": {
        "configuration_digest": {
          "type": "string"
        },
        "incomplete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "overall_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "producer": {
          "$ref": "#/$defs/ProducerEvidence"
        },
        "redaction_policy_version": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryEvidence"
        },
        "run": {
          "$ref": "#/$defs/RunEvidence"
        },
        "runtime_receipts": {
          "items": {
            "$ref": "#/$defs/MatrixRuntimeReceiptV2"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "repository",
        "run",
        "configuration_digest",
        "runtime_receipts",
        "overall_status",
        "redaction_policy_version"
      ],
      "type": "object"
    },
    "MatrixRuntimeReceiptV2": {
      "additionalProperties": false,
      "properties": {
        "receipt": {
          "$ref": "#/$defs/ReceiptEnvelopeV1"
        },
        "runtime_id": {
          "type": "string"
        }
      },
      "required": [
        "runtime_id",
        "receipt"
      ],
      "type": "object"
    },
    "PlatformEvidence": {
      "additionalProperties": false,
      "properties": {
        "host_arch": {
          "type": "string"
        },
        "host_os": {
          "type": "string"
        },
        "image_digest": {
          "type": "string"
        },
        "image_reference": {
          "type": "string"
        },
        "runtime_kind": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        }
      },
      "required": [
        "host_os",
        "host_arch",
        "runtime_kind",
        "runtime_version",
        "image_reference",
        "image_digest"
      ],
      "type": "object"
    },
    "ProducerEvidence": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ReceiptEnvelopeV1": {
      "additionalProperties": false,
      "properties": {
        "receipt": {
          "$ref": "#/$defs/ReceiptV1"
        },
        "receipt_id": {
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "receipt"
      ],
      "type": "object"
    },
    "ReceiptV1": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckEvidence"
          },
          "type": "array"
        },
        "configuration_digest": {
          "type": "string"
        },
        "incomplete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "overall_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "platform": {
          "$ref": "#/$defs/PlatformEvidence"
        },
        "producer": {
          "$ref": "#/$defs/ProducerEvidence"
        },
        "redaction_policy_version": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryEvidence"
        },
        "run": {
          "$ref": "#/$defs/RunEvidence"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "repository",
        "run",
        "platform",
        "configuration_digest",
        "checks",
        "overall_status",
        "redaction_policy_version"
      ],
      "type": "object"
    },
    "ReceiptV2": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckEvidence"
          },
          "type": "array"
        },
        "configuration_digest": {
          "type": "string"
        },
        "incomplete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "overall_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "platform": {
          "$ref": "#/$defs/PlatformEvidence"
        },
        "producer": {
          "$ref": "#/$defs/ProducerEvidence"
        },
        "redaction_policy_version": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryEvidence"
        },
        "run": {
          "$ref": "#/$defs/RunEvidence"
        },
        "schema_version": {
          "type": "string"
        },
        "source_snapshot": {
          "$ref": "#/$defs/SourceSnapshotEvidence"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "repository",
        "run",
        "source_snapshot",
        "platform",
        "configuration_digest",
        "checks",
        "overall_status",
        "redaction_policy_version"
      ],
      "type": "object"
    },
    "RepositoryEvidence": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "dirty"
      ],
      "type": "object"
    },
    "RunEvidence": {
      "additionalProperties": false,
      "properties": {
        "finished_at_utc": {
          "type": "string"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        },
        "started_at_utc": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "generation",
        "started_at_utc",
        "finished_at_utc"
      ],
      "type": "object"
    },
    "SourceSnapshotEvidence": {
      "additionalProperties": false,
      "properties": {
        "entry_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "manifest_digest": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/SourceSnapshotStrategy"
        }
      },
      "required": [
        "schema_version",
        "strategy",
        "manifest_digest",
        "entry_count"
      ],
      "type": "object"
    },
    "SourceSnapshotStrategy": {
      "enum": [
        "git-object",
        "git-archive",
        "detached-worktree"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "receipt": {
      "oneOf": [
        {
          "$ref": "#/$defs/MatrixReceiptV2"
        },
        {
          "$ref": "#/$defs/ReceiptV2"
        }
      ]
    },
    "receipt_id": {
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "receipt"
  ],
  "title": "ReceiptContractsV2",
  "type": "object"
}
