{
  "$defs": {
    "ArtifactEvidence": {
      "additionalProperties": false,
      "properties": {
        "entry_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "manifest_digest": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "producer_check": {
          "type": "string"
        },
        "total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "producer_check",
        "entry_count",
        "total_bytes",
        "manifest_digest"
      ],
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "regular-file",
        "directory"
      ],
      "type": "string"
    },
    "CheckEvidence": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cancelled": {
          "type": "boolean"
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exit_code": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "incomplete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "timed_out": {
          "type": "boolean"
        },
        "working_directory": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "required",
        "argv",
        "working_directory",
        "status",
        "duration_ms",
        "timed_out",
        "cancelled"
      ],
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING",
        "NOT_RUN"
      ],
      "type": "string"
    },
    "ExecutionPlanV1": {
      "additionalProperties": false,
      "properties": {
        "caches": {
          "items": {
            "$ref": "#/$defs/NormalizedCache"
          },
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/NormalizedCheck"
          },
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/NormalizedEnvironment"
        },
        "project": {
          "type": "string"
        },
        "receipt": {
          "$ref": "#/$defs/NormalizedReceipt"
        },
        "runtime": {
          "$ref": "#/$defs/NormalizedRuntime"
        },
        "schema_version": {
          "type": "string"
        },
        "storage": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedStorage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "project",
        "runtime",
        "receipt",
        "environment",
        "caches",
        "checks"
      ],
      "type": "object"
    },
    "MatrixReceiptV2": {
      "additionalProperties": false,
      "properties": {
        "configuration_digest": {
          "type": "string"
        },
        "incomplete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "overall_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "producer": {
          "$ref": "#/$defs/ProducerEvidence"
        },
        "redaction_policy_version": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryEvidence"
        },
        "run": {
          "$ref": "#/$defs/RunEvidence"
        },
        "runtime_receipts": {
          "items": {
            "$ref": "#/$defs/MatrixRuntimeReceiptV2"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "repository",
        "run",
        "configuration_digest",
        "runtime_receipts",
        "overall_status",
        "redaction_policy_version"
      ],
      "type": "object"
    },
    "MatrixRuntimeReceiptV2": {
      "additionalProperties": false,
      "properties": {
        "receipt": {
          "$ref": "#/$defs/ReceiptEnvelopeV1"
        },
        "runtime_id": {
          "type": "string"
        }
      },
      "required": [
        "runtime_id",
        "receipt"
      ],
      "type": "object"
    },
    "NormalizedArtifactContract": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_entries": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "producer_check": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "max_bytes",
        "max_entries",
        "producer_check"
      ],
      "type": "object"
    },
    "NormalizedCache": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "mount_path": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "mount_path"
      ],
      "type": "object"
    },
    "NormalizedCheck": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "artifact_contracts": {
          "items": {
            "$ref": "#/$defs/NormalizedArtifactContract"
          },
          "type": "array"
        },
        "artifacts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "working_directory": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "required",
        "argv",
        "working_directory",
        "timeout_seconds",
        "depends_on",
        "artifacts"
      ],
      "type": "object"
    },
    "NormalizedEnvironment": {
      "additionalProperties": false,
      "properties": {
        "fixed": {
          "items": {
            "$ref": "#/$defs/NormalizedFixedEnvironment"
          },
          "type": "array"
        },
        "inherit": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "remote_secret_only": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runtime_internal": {
          "items": {
            "$ref": "#/$defs/NormalizedRuntimeInternalEnvironment"
          },
          "type": "array"
        }
      },
      "required": [
        "inherit",
        "fixed",
        "runtime_internal",
        "remote_secret_only"
      ],
      "type": "object"
    },
    "NormalizedFixedEnvironment": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value_digest": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value_digest"
      ],
      "type": "object"
    },
    "NormalizedReceipt": {
      "additionalProperties": false,
      "properties": {
        "freshness_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output": {
          "type": "string"
        }
      },
      "required": [
        "output",
        "freshness_seconds"
      ],
      "type": "object"
    },
    "NormalizedRuntime": {
      "additionalProperties": false,
      "properties": {
        "cpu_count": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "image": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "memory_mib": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "network": {
          "type": "boolean"
        },
        "pids_limit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pull_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimePullPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "swap_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeSwapMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "image",
        "cpu_count",
        "memory_mib",
        "pids_limit",
        "network"
      ],
      "type": "object"
    },
    "NormalizedRuntimeInternalEnvironment": {
      "additionalProperties": false,
      "properties": {
        "cache_id": {
          "type": "string"
        },
        "container_target": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "cache_id",
        "container_target"
      ],
      "type": "object"
    },
    "NormalizedStorage": {
      "additionalProperties": false,
      "properties": {
        "max_artifact_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_cache_growth_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "min_free_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "receipt_journal_reserve_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "min_free_bytes",
        "receipt_journal_reserve_bytes",
        "max_cache_growth_bytes",
        "max_artifact_bytes"
      ],
      "type": "object"
    },
    "PlatformEvidence": {
      "additionalProperties": false,
      "properties": {
        "host_arch": {
          "type": "string"
        },
        "host_os": {
          "type": "string"
        },
        "image_digest": {
          "type": "string"
        },
        "image_reference": {
          "type": "string"
        },
        "runtime_kind": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        }
      },
      "required": [
        "host_os",
        "host_arch",
        "runtime_kind",
        "runtime_version",
        "image_reference",
        "image_digest"
      ],
      "type": "object"
    },
    "ProducerEvidence": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ReceiptEnvelopeV1": {
      "additionalProperties": false,
      "properties": {
        "receipt": {
          "$ref": "#/$defs/ReceiptV1"
        },
        "receipt_id": {
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "receipt"
      ],
      "type": "object"
    },
    "ReceiptV1": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckEvidence"
          },
          "type": "array"
        },
        "configuration_digest": {
          "type": "string"
        },
        "incomplete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "overall_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "platform": {
          "$ref": "#/$defs/PlatformEvidence"
        },
        "producer": {
          "$ref": "#/$defs/ProducerEvidence"
        },
        "redaction_policy_version": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryEvidence"
        },
        "run": {
          "$ref": "#/$defs/RunEvidence"
        },
        "schema_version": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "repository",
        "run",
        "platform",
        "configuration_digest",
        "checks",
        "overall_status",
        "redaction_policy_version"
      ],
      "type": "object"
    },
    "ReceiptV2": {
      "additionalProperties": false,
      "properties": {
        "artifact_manifest": {
          "items": {
            "$ref": "#/$defs/ArtifactEvidence"
          },
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckEvidence"
          },
          "type": "array"
        },
        "configuration_digest": {
          "type": "string"
        },
        "execution_plan": {
          "$ref": "#/$defs/ExecutionPlanV1"
        },
        "incomplete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "overall_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "platform": {
          "$ref": "#/$defs/PlatformEvidence"
        },
        "producer": {
          "$ref": "#/$defs/ProducerEvidence"
        },
        "redaction_policy_version": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryEvidence"
        },
        "run": {
          "$ref": "#/$defs/RunEvidence"
        },
        "runtime_capability_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeCapabilityEvidenceV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "type": "string"
        },
        "source_snapshot": {
          "$ref": "#/$defs/SourceSnapshotEvidence"
        }
      },
      "required": [
        "schema_version",
        "producer",
        "repository",
        "run",
        "source_snapshot",
        "platform",
        "configuration_digest",
        "execution_plan",
        "checks",
        "overall_status",
        "redaction_policy_version"
      ],
      "type": "object"
    },
    "RepositoryEvidence": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "repository": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "dirty"
      ],
      "type": "object"
    },
    "RunEvidence": {
      "additionalProperties": false,
      "properties": {
        "finished_at_utc": {
          "type": "string"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        },
        "started_at_utc": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "generation",
        "started_at_utc",
        "finished_at_utc"
      ],
      "type": "object"
    },
    "RuntimeCapabilityEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "context_digest": {
          "type": "string"
        },
        "memory_limit_supported": {
          "type": "boolean"
        },
        "resolved_image_id": {
          "type": "string"
        },
        "resolved_image_reference": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "swap_limit_supported": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "memory_limit_supported",
        "swap_limit_supported",
        "context_digest",
        "resolved_image_id",
        "resolved_image_reference"
      ],
      "type": "object"
    },
    "RuntimeKind": {
      "enum": [
        "docker_compatible",
        "host"
      ],
      "type": "string"
    },
    "RuntimePullPolicy": {
      "enum": [
        "never"
      ],
      "type": "string"
    },
    "RuntimeSwapMode": {
      "enum": [
        "disabled"
      ],
      "type": "string"
    },
    "SourceSnapshotEvidence": {
      "additionalProperties": false,
      "properties": {
        "entry_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "manifest_digest": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/SourceSnapshotStrategy"
        }
      },
      "required": [
        "schema_version",
        "strategy",
        "manifest_digest",
        "entry_count"
      ],
      "type": "object"
    },
    "SourceSnapshotStrategy": {
      "enum": [
        "git-object",
        "git-archive",
        "detached-worktree"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "receipt": {
      "oneOf": [
        {
          "$ref": "#/$defs/MatrixReceiptV2"
        },
        {
          "$ref": "#/$defs/ReceiptV2"
        }
      ]
    },
    "receipt_id": {
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "receipt"
  ],
  "title": "ReceiptContractsV2",
  "type": "object"
}
