{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationPolicyV1",
  "type": "object",
  "properties": {
    "configuration_digest": {
      "type": "string"
    },
    "image_reference": {
      "type": "string"
    },
    "max_age_seconds": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AcceptedPlatformV1"
      }
    },
    "project": {
      "type": "string"
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "configuration_digest",
    "required_checks",
    "image_reference",
    "max_age_seconds",
    "platforms"
  ],
  "$defs": {
    "AcceptedPlatformV1": {
      "type": "object",
      "properties": {
        "host_arch": {
          "type": "string"
        },
        "host_os": {
          "type": "string"
        },
        "runtime_kind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_os",
        "host_arch",
        "runtime_kind"
      ]
    }
  }
}